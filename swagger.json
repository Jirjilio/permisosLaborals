      "post": {
        "description": "Crea un nou permís",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
               "required": ["empleatCreadorId", "dataInici", "dataFinal", "tipus", "descripcio"],
              "properties": {
                "empleatCreadorId": { "example": "ID-123" },
                "dataCreacio": { "example": "2026-05-18T14:00:00.000Z" },
                "dataInici": { "example": "2026-05-20T00:00:00.000Z" },
                "dataFinal": { "example": "2026-05-22T00:00:00.000Z" },
                "tipus": { "example": "malaltia" },
                "descripcio": { "example": "Baixa mèdica" },
                "estat": { "example": "pendent" },
                "empleatTramitadorId": { "example": "admin-id" },
                "dataTramitacio": { "example": "2026-05-18T14:00:00.000Z" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "default": {
            "description": ""
          }
        }
      },
      "get": {
        "description": "Llista els permisos accessibles per l'usuari autenticat",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
